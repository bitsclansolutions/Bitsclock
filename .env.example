# ---- Database (Supabase Postgres) ---------------------------------------------
# Project settings -> Database -> Connection string.
# DATABASE_URL: "Transaction" pooler (port 6543), used by the app at runtime (Prisma 7 pg adapter).
#   connection_limit becomes the pool size: ~10 for one long-running server; 3-5 on Vercel,
#   where every function instance has its own pool.
# DIRECT_URL: "Session" / direct connection (port 5432), used by `prisma migrate` (prisma.config.ts).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=8"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"
# Optional: the database's CA certificate (PEM, "\n" for line breaks) to verify TLS.
# Without it the connection is encrypted but the certificate isn't checked (Prisma 6 behaviour).
# DATABASE_CA_CERT=""

# ---- Redis (Upstash) ----------------------------------------------------------
# REQUIRED in production (D-004): the server refuses to start without it, because cache
# invalidations and rate limits must be shared by every instance. Optional locally.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- Sessions -----------------------------------------------------------------
# Random string of at least 32 characters used to sign session cookies.
AUTH_SECRET="change-me-to-a-long-random-string"

# ---- Public address -----------------------------------------------------------
# REQUIRED in production, https:// (R-062): links in emails are built only from this,
# never from request headers. Also decides whether cookies need HTTPS (http://localhost doesn't).
APP_URL="http://localhost:3000"

# ---- Email (SMTP) -------------------------------------------------------------
# Member invitations (sign-in link + temporary password), administrator password resets and
# the "forgot password" code. Any SMTP provider works. Leave SMTP_HOST empty to disable: in
# development the message is printed to the server console, and the Team page shows the
# temporary password once so it can be passed on by hand.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# true for implicit TLS on port 465; leave false for STARTTLS on 587.
SMTP_SECURE="false"
# Sender shown to recipients. Many providers require a verified address/domain here.
MAIL_FROM="Bitsclock <no-reply@example.com>"

# ---- Rate limits (optional; defaults shown) -----------------------------------
# Per IP per route per minute.
# RATE_LIMIT_READS_PER_MIN=600
# RATE_LIMIT_WRITES_PER_MIN=120
# Sign-in and session refresh, per IP per 15 minutes. A whole office shares one IP.
# LOGIN_LIMIT_PER_IP=300
# REFRESH_LIMIT_PER_IP=300
# Failed sign-ins per account (all IPs) per 15 minutes; per account + IP it's always 8.
# LOGIN_LIMIT_PER_ACCOUNT=50
# Per signed-in user, all routes, per minute.
# USER_READS_PER_MIN=300
# USER_WRITES_PER_MIN=60
# Header your host's proxy sets with the real client IP (clients can't forge it), e.g.
# "x-real-ip" or "cf-connecting-ip". Vercel's x-real-ip is used automatically.
# CLIENT_IP_HEADER=""

# ---- Seed (npm run db:seed) ---------------------------------------------------
# Creates the system roles and the single Administrator when none exists. No defaults:
# the seed refuses to run without these, and never prints the password.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Demo members, projects and entries: development databases only (refused in production).
# SEED_DEMO=1
# SEED_DEMO_PASSWORD=""

# ---- Break-glass (npm run admin:recover) --------------------------------------
# New password for the recovered Administrator; generated and printed once when unset.
# ADMIN_RECOVER_PASSWORD=""
