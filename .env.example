# Supabase Postgres. Project settings -> Database -> Connection string.
# DATABASE_URL: "Transaction" pooler (port 6543) with pgbouncer=true, used at runtime.
#   connection_limit: ~10 for one long-running server (local dev / VPS).
#   On Vercel each function instance has its own pool, so use 3-5 there and let instances scale out.
# DIRECT_URL:   "Session" / direct connection (port 5432), used by prisma db push and migrations.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=8&pool_timeout=30"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# Optional but recommended on Vercel / any multi-instance deployment: a shared Redis
# (Upstash, free tier is enough) so the response cache and rate limits are shared by
# every instance. Leave unset for a single server; per-process memory is used instead.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional: per-IP, per-route request limits per minute (defaults 600 reads / 120 writes).
# Raise them when many users share one public IP (office NAT, VPN).
# RATE_LIMIT_READS_PER_MIN=600
# RATE_LIMIT_WRITES_PER_MIN=120

# Random string of at least 32 characters used to sign session cookies.
AUTH_SECRET="change-me-to-a-long-random-string"

# Outgoing email over SMTP: member invitations (sign-in link + temporary password),
# administrator password resets and the "forgot password" code. Any SMTP provider works
# (Gmail app password, Brevo, Resend SMTP, Mailgun, Office 365, ...). Leave SMTP_HOST empty
# to disable: in development the message is printed to the server console instead, and the
# Team page shows the temporary password so it can be passed on by hand.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# true for implicit TLS on port 465; leave false for STARTTLS on 587.
SMTP_SECURE="false"
# Sender shown to recipients. Many providers require a verified address/domain here.
MAIL_FROM="Bitsclock <no-reply@example.com>"
# Public URL used for links in emails. Falls back to the request host when unset.
APP_URL="http://localhost:3000"

# Optional: credentials for the first administrator created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@bitsclock.com"
SEED_ADMIN_PASSWORD="Admin@12345"
