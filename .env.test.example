# Copy to .env.test. Used only by `npm test` and `npm run test:e2e`.
# Must point at a LOCAL Postgres database whose name ends in _test: the suite empties
# every table, and scripts/test-env.mjs refuses any other host or database name.
# Setup used on the development machine: Postgres inside WSL Ubuntu (see docs/05-quality/testing.md).
DATABASE_URL="postgresql://bitsclock_test:<local-password>@localhost:5432/bitsclock_test"
DIRECT_URL="postgresql://bitsclock_test:<local-password>@localhost:5432/bitsclock_test"
# Any random string of 32+ characters; only signs test sessions.
AUTH_SECRET="<random-32-plus-characters>"
# Keep Redis, SMTP and real rate limits off in tests.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
RATE_LIMIT_READS_PER_MIN="100000"
RATE_LIMIT_WRITES_PER_MIN="100000"
USER_READS_PER_MIN="100000"
USER_WRITES_PER_MIN="100000"
LOGIN_LIMIT_PER_IP="100000"
REFRESH_LIMIT_PER_IP="100000"
SMTP_HOST=""
MAIL_FROM=""
APP_URL="http://localhost:3100"
# Windows only: start Postgres inside this WSL distro for the test run (leave empty otherwise).
TEST_DB_WSL_DISTRO=""
